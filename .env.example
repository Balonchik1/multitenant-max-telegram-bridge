# Скопируй в .env и заполни своими значениями. .env никогда не должен
# попадать в git (см. .gitignore) — там лежат реальные секреты.

# Токен Telegram-бота от @BotFather
TG_TOKEN=

# id твоей основной Telegram-группы с включёнными Темами (Topics) —
# именно туда попадают темы по умолчанию
TG_GROUP_ID=

# id "плоской" TG-группы без тем (опционально, для отдельного flat-режима
# — например, чтобы коллеги без MAX-аккаунта читали конкретный MAX-чат
# без деления на темы)
TG_GROUP_FLAT=

# MAX chat_id того чата, что зеркалится в TG_GROUP_FLAT
FLAT_MAX_CHAT_ID=

# Твой Telegram user id (админ бота) — узнать можно, например, у @userinfobot
ADMIN_ID=

# Номер телефона твоего MAX-аккаунта в международном формате
MAX_PHONE=

# Необязательно: облачный пароль MAX (2FA) — если задан, вход под ADMIN_ID
# подставляет его автоматически вместо запроса в личке. Без этого поля
# бот просто спросит пароль как обычно.
MAX_2FA_PASSWORD=

# Необязательно: ключ шифрования для периодических бэкапов файлов сессии
# (cache/ у тебя и у каждого тенанта) — см. session_backup.py. Без этого
# поля автобэкапы просто не делаются. Держи этот ключ отдельно от самих
# бэкапов (например не в одном хранилище) — иначе шифрование бессмысленно.
SESSION_BACKUP_KEY=
